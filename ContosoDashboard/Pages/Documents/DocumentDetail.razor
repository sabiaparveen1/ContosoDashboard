@page "/documents/detail/{DocumentId:int}"
@using ContosoDashboard.Models
@using ContosoDashboard.Services.Documents
@inject IDocumentService DocumentService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>Document Details</PageTitle>

<div class="container mt-4">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading document...</p>
        </div>
    }
    else if (document == null)
    {
        <div class="alert alert-warning">Document not found</div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <h2>@document.Title</h2>
                        @if (!string.IsNullOrEmpty(document.Description))
                        {
                            <p class="text-muted">@document.Description</p>
                        }

                        <div class="row mt-4 mb-4">
                            <div class="col-md-6">
                                <p><strong>File Name:</strong> @document.FileName</p>
                                <p><strong>Size:</strong> @FormatFileSize(document.FileSizeBytes)</p>
                                <p><strong>Type:</strong> <span class="badge bg-secondary">@document.FileExtension</span></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Uploaded By:</strong> @document.UploadedByUser.DisplayName</p>
                                <p><strong>Uploaded On:</strong> @document.UploadedDate.ToString("yyyy-MM-dd HH:mm:ss")</p>
                                <p><strong>Last Updated:</strong> @document.UpdatedDate.ToString("yyyy-MM-dd HH:mm:ss")</p>
                            </div>
                        </div>

                        @if (document.DocumentTags.Count > 0)
                        {
                            <div class="mb-4">
                                <strong>Tags:</strong>
                                @foreach (var tag in document.DocumentTags)
                                {
                                    <span class="badge bg-info">@tag.Tag.Name</span>
                                }
                            </div>
                        }

                        <div class="d-flex gap-2 mb-4">
                            <a href="/api/documents/@document.DocumentId/download" class="btn btn-primary" target="_blank">
                                Download
                            </a>
                            @if (IsPreviewable())
                            {
                                <a href="/api/documents/@document.DocumentId/preview" class="btn btn-secondary" target="_blank">
                                    Preview
                                </a>
                            }
                            @if (IsOwner())
                            {
                                <button class="btn btn-warning" @onclick="ToggleEditMode">
                                    Edit
                                </button>
                                <button class="btn btn-danger" @onclick="ShowDeleteConfirm">
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>

                @if (isEditMode && IsOwner())
                {
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5>Edit Document Metadata</h5>
                        </div>
                        <div class="card-body">
                            <form @onsubmit="SaveMetadata">
                                <div class="mb-3">
                                    <label for="editTitle" class="form-label">Title</label>
                                    <input type="text" class="form-control" id="editTitle" @bind="editTitle" />
                                </div>

                                <div class="mb-3">
                                    <label for="editDescription" class="form-label">Description</label>
                                    <textarea class="form-control" id="editDescription" @bind="editDescription" rows="3"></textarea>
                                </div>

                                <div class="mb-3">
                                    <label for="editTags" class="form-label">Tags (comma-separated)</label>
                                    <input type="text" class="form-control" id="editTags" @bind="editTagsInput" placeholder="e.g. important, project-x, urgent" />
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                        @if (isSaving)
                                        {
                                            <span>Saving...</span>
                                        }
                                        else
                                        {
                                            <span>Save Changes</span>
                                        }
                                    </button>
                                    <button type="button" class="btn btn-secondary" @onclick="ToggleEditMode">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }

                @if (showDeleteConfirm)
                {
                    <div class="card card-danger mb-4">
                        <div class="card-body">
                            <h5 class="card-title text-danger">Delete Document</h5>
                            <p>Are you sure you want to delete this document? This action cannot be undone.</p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                                    @if (isDeleting)
                                    {
                                        <span>Deleting...</span>
                                    }
                                    else
                                    {
                                        <span>Yes, Delete Permanently</span>
                                    }
                                </button>
                                <button class="btn btn-secondary" @onclick="() => showDeleteConfirm = false">Cancel</button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-4">
                @if (document.Shares.Count > 0)
                {
                    <div class="card">
                        <div class="card-header">
                            <h5>Shared With</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var share in document.Shares)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <div>
                                        <p class="mb-0">@share.SharedWithUser.DisplayName</p>
                                        <small class="text-muted">@share.SharedWithUser.Email</small>
                                    </div>
                                    @if (IsOwner())
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RevokeShare(share.DocumentShareId)" title="Revoke access">
                                            ×
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <a href="/documents/my-documents" class="btn btn-secondary">Back to My Documents</a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int DocumentId { get; set; }

    private Document? document;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading = true;
    private int currentUserId = 0;

    // Edit mode
    private bool isEditMode = false;
    private string editTitle = string.Empty;
    private string editDescription = string.Empty;
    private string editTagsInput = string.Empty;
    private bool isSaving = false;

    // Delete mode
    private bool showDeleteConfirm = false;
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(userClaim, out currentUserId))
            {
                errorMessage = "Unable to determine current user";
                return;
            }

            await LoadDocument();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error initializing: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDocument()
    {
        try
        {
            isLoading = true;
            document = await DocumentService.GetDocumentByIdAsync(DocumentId, currentUserId);
            if (document != null)
            {
                editTitle = document.Title;
                editDescription = document.Description ?? string.Empty;
                editTagsInput = string.Join(", ", document.DocumentTags.Select(dt => dt.Tag.Name));
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading document: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsOwner()
    {
        return document?.UploadedByUserId == currentUserId;
    }

    private bool IsPreviewable()
    {
        if (document == null) return false;
        var previewableExtensions = new[] { ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".bmp", ".txt" };
        return previewableExtensions.Contains(document.FileExtension.ToLowerInvariant());
    }

    private void ToggleEditMode()
    {
        isEditMode = !isEditMode;
        if (!isEditMode && document != null)
        {
            editTitle = document.Title;
            editDescription = document.Description ?? string.Empty;
            editTagsInput = document.DocumentTags.Count > 0 ? string.Join(", ", document.DocumentTags.Select(dt => dt.Tag.Name)) : string.Empty;
        }
    }

    private async Task SaveMetadata()
    {
        if (document == null || !IsOwner()) return;

        try
        {
            isSaving = true;
            var tags = editTagsInput.Split(',').Select(t => t.Trim()).Where(t => !string.IsNullOrEmpty(t)).ToList();

            var updated = await DocumentService.UpdateMetadataAsync(
                DocumentId,
                editTitle,
                editDescription,
                tags,
                currentUserId);

            document = updated;
            isEditMode = false;
            successMessage = "Document metadata updated successfully!";

            await Task.Delay(2000);
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving metadata: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowDeleteConfirm()
    {
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (document == null || !IsOwner()) return;

        try
        {
            isDeleting = true;
            await DocumentService.DeleteAsync(DocumentId, currentUserId);
            successMessage = "Document deleted successfully!";

            await Task.Delay(2000);
            Navigation.NavigateTo("/documents/my-documents");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting document: {ex.Message}";
            isDeleting = false;
        }
    }

    private async Task RevokeShare(int shareId)
    {
        try
        {
            await DocumentService.RevokeShareAsync(shareId, currentUserId);
            successMessage = "Share revoked successfully!";
            await LoadDocument();
            await Task.Delay(2000);
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error revoking share: {ex.Message}";
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
