@page "/documents/upload"
@using ContosoDashboard.Models
@using ContosoDashboard.Services.Documents
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject IDocumentService Documents
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Upload> Logger
@attribute [Authorize]

<PageTitle>Upload Document</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>Upload Document</h3>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                        </div>
                    }

                    <EditForm Model="@uploadModel" OnValidSubmit="@HandleUpload">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
                            <InputText class="form-control" id="title" @bind-Value="uploadModel.Title" />
                        </div>

                        <div class="mb-3">
                            <label for="category" class="form-label">Category <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" id="category" @bind-Value="uploadModel.Category">
                                <option value="">-- Select a category --</option>
                                @foreach (var category in DocumentCategories.All)
                                {
                                    <option value="@category">@category</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => uploadModel.Category)" />
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <InputTextArea class="form-control" id="description" @bind-Value="uploadModel.Description" rows="3"></InputTextArea>
                        </div>

                        <div class="mb-3">
                            <label for="file" class="form-label">Select File <span class="text-danger">*</span></label>
                            <InputFile class="form-control" id="file" OnChange="@HandleFileSelected" disabled="@isUploading" />
                            <small class="form-text text-muted">
                                Max size: 25 MB. Allowed types: PDF, Word, Excel, Text, Images, PowerPoint
                            </small>
                        </div>

                        @if (selectedFile != null)
                        {
                            <div class="mb-3">
                                <p class="text-muted">
                                    <strong>Selected file:</strong> @selectedFile.Name (@FormatFileSize(selectedFile.Size))
                                </p>
                                @if (uploadProgress > 0)
                                {
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar" style="width: @(uploadProgress)%">
                                            @(uploadProgress)%
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label for="projectId" class="form-label">Project (Optional)</label>
                            <InputSelect class="form-select" id="projectId" @bind-Value="uploadModel.ProjectId">
                                <option value="">-- Select a project --</option>
                                @foreach (var project in projects)
                                {
                                    <option value="@project.ProjectId">@project.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@(isUploading || selectedFile == null)">
                                @if (isUploading)
                                {
                                    <span>Uploading...</span>
                                }
                                else
                                {
                                    <span>Upload Document</span>
                                }
                            </button>
                        </div>
                    </EditForm>

                    <hr />

                    <div class="mt-3">
                        <a href="/documents/my-documents" class="btn btn-secondary">Back to My Documents</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private class UploadModel
    {
        public string Title { get; set; } = string.Empty;
        [Required(ErrorMessage = "Select a document category.")]
        public string Category { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string ProjectId { get; set; } = string.Empty;
    }

    private UploadModel uploadModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isUploading = false;
    private int uploadProgress = 0;
    private IBrowserFile? selectedFile;
    private List<Project> projects = new();
    private int currentUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(userClaim, out currentUserId))
            {
                errorMessage = "Unable to determine current user";
                return;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error initializing: {ex.Message}";
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        selectedFile = e.FileCount == 1 ? e.File : null;
        if (selectedFile == null)
            errorMessage = "Select one file.";
        else if (selectedFile.Size > DocumentService.MaxFileSizeBytes)
        {
            errorMessage = "File size exceeds the maximum allowed size of 25 MB.";
            selectedFile = null;
        }
    }

    private async Task HandleUpload()
    {
        if (isUploading) return;

        if (currentUserId <= 0)
        {
            errorMessage = "Unable to determine current user.";
            return;
        }

        if (selectedFile == null || string.IsNullOrWhiteSpace(uploadModel.Title))
        {
            errorMessage = "Title and file are required";
            return;
        }

        isUploading = true;
        uploadProgress = 0;
        errorMessage = string.Empty;

        try
        {
            await using var fileStream = selectedFile.OpenReadStream(maxAllowedSize: DocumentService.MaxFileSizeBytes);
            int? projectId = null;
            if (!string.IsNullOrEmpty(uploadModel.ProjectId) && int.TryParse(uploadModel.ProjectId, out int projId))
            {
                projectId = projId;
            }

            await Documents.UploadAsync(
                fileStream,
                selectedFile.Name,
                uploadModel.Title,
                uploadModel.Category,
                uploadModel.Description,
                projectId,
                currentUserId
            );

            successMessage = "Document uploaded successfully!";
            uploadModel = new();
            selectedFile = null;
            uploadProgress = 0;

            await Task.Delay(2000);
            Navigation.NavigateTo("/documents/my-documents");
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "Document upload rejected for user {UserId}", currentUserId);
            errorMessage = $"Upload failed: {ex.Message}";
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Document upload denied for user {UserId}", currentUserId);
            errorMessage = "You do not have permission to upload to this project.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Document upload failed for user {UserId}", currentUserId);
            errorMessage = "An error occurred while uploading the file. Check the server log for details.";
        }
        finally
        {
            isUploading = false;
            uploadProgress = 0;
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

}

