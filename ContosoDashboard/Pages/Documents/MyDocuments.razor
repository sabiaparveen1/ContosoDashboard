@page "/documents/my-documents"
@using ContosoDashboard.Models
@using ContosoDashboard.Services.Documents
@inject IDocumentService DocumentService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>My Documents</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>My Documents</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="/documents/upload" class="btn btn-primary">
                <i class="bi bi-cloud-upload"></i> Upload Document
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading documents...</p>
                </div>
            }
            else if (documents.Count == 0)
            {
                <div class="text-center py-5">
                    <p class="text-muted">No documents yet. <a href="/documents/upload">Upload your first document</a></p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Uploaded</th>
                                <th>Size</th>
                                <th>Type</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in documents)
                            {
                                <tr>
                                    <td>
                                        <a href="/documents/detail/@doc.DocumentId" class="text-decoration-none">
                                            <strong>@doc.Title</strong>
                                        </a>
                                        @if (!string.IsNullOrEmpty(doc.Description))
                                        {
                                            <div class="text-muted small">@doc.Description</div>
                                        }
                                        @if (doc.DocumentTags.Count > 0)
                                        {
                                            <div class="mt-2">
                                                @foreach (var tag in doc.DocumentTags)
                                                {
                                                    <span class="badge bg-info">@tag.Tag.Name</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @doc.UploadedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>
                                    <td>
                                        @FormatFileSize(doc.FileSizeBytes)
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@doc.FileExtension</span>
                                    </td>
                                    <td class="text-end">
                                        <a href="/api/documents/@doc.DocumentId/download" class="btn btn-sm btn-outline-primary" target="_blank" title="Download">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        <a href="/documents/detail/@doc.DocumentId" class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Document> documents = new();
    private string errorMessage = string.Empty;
    private bool isLoading = true;
    private int currentUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(userClaim, out currentUserId))
            {
                errorMessage = "Unable to determine current user";
                return;
            }

            await LoadDocuments();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error initializing: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDocuments()
    {
        try
        {
            isLoading = true;
            documents = await DocumentService.GetMyDocumentsAsync(currentUserId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading documents: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
